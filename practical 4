#include <stdio.h>
#include <string.h>

#define MAX 100

/* Structure declaration */
struct Student
{
    int roll_no;
    char name[50];
    float marks;
};

struct Student s[MAX];

int n = 0;

/* Function declarations */
void create();
void display();
void modify();
void search();
void sort();

/* Create records */
void create()
{
    int i;

    printf("\nEnter number of students: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++)
    {
        printf("\nEnter details of student %d\n", i + 1);

        printf("Enter Roll No.: ");
        scanf("%d", &s[i].roll_no);

        printf("Enter Name: ");
        scanf("%s", s[i].name);

        printf("Enter Marks: ");
        scanf("%f", &s[i].marks);
    }

    printf("\nRecords created successfully!\n");
}

/* Display records */
void display()
{
    int i;

    if (n == 0)
    {
        printf("\nNo records available!\n");
        return;
    }

    printf("\n---------- STUDENT DATABASE ----------\n");

    printf("\nRoll No.\tName\t\tMarks\n");
    printf("--------------------------------------\n");

    for (i = 0; i < n; i++)
    {
        printf("%d\t\t%s\t\t%.2f\n",
               s[i].roll_no,
               s[i].name,
               s[i].marks);
    }
}

/* Modify record */
void modify()
{
    int roll, i, found = 0;

    printf("\nEnter Roll No. to modify: ");
    scanf("%d", &roll);

    for (i = 0; i < n; i++)
    {
        if (s[i].roll_no == roll)
        {
            printf("\nEnter new details:\n");

            printf("Enter Name: ");
            scanf("%s", s[i].name);

            printf("Enter Marks: ");
            scanf("%f", &s[i].marks);

            found = 1;

            printf("\nRecord modified successfully!\n");
            break;
        }
    }

    if (found == 0)
    {
        printf("\nRecord not found!\n");
    }
}

/* Search record */
void search()
{
    int roll, i, found = 0;

    printf("\nEnter Roll No. to search: ");
    scanf("%d", &roll);

    for (i = 0; i < n; i++)
    {
        if (s[i].roll_no == roll)
        {
            printf("\nRecord found!\n");
            printf("Roll No.: %d\n", s[i].roll_no);
            printf("Name: %s\n", s[i].name);
            printf("Marks: %.2f\n", s[i].marks);

            found = 1;
            break;
        }
    }

    if (found == 0)
    {
        printf("\nRecord not found!\n");
    }
}

/* Sort records according to Roll No. */
void sort()
{
    int i, j;
    struct Student temp;

    for (i = 0; i < n - 1; i++)
    {
        for (j = 0; j < n - i - 1; j++)
        {
            if (s[j].roll_no > s[j + 1].roll_no)
            {
                temp = s[j];
                s[j] = s[j + 1];
                s[j + 1] = temp;
            }
        }
    }

    printf("\nRecords sorted successfully!\n");
}

/* Main function */
int main()
{
    int choice;

    do
    {
        printf("\n\n========== DATABASE MANAGEMENT ==========");
        printf("\n1. Create");
        printf("\n2. Display");
        printf("\n3. Modify");
        printf("\n4. Search");
        printf("\n5. Sort");
        printf("\n6. Exit");

        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                create();
                break;

            case 2:
                display();
                break;

            case 3:
                modify();
                break;

            case 4:
                search();
                break;

            case 5:
                sort();
                break;

            case 6:
                printf("\nExiting program...");
                break;

            default:
                printf("\nInvalid choice!");
        }

    } while (choice != 6);

    return 0;
}
