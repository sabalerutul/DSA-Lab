
#include <stdio.h>

/* Function for Recursive Binary Search */
int binarySearch(int arr[], int low, int high, int target)
{
    int mid;

    /* Base condition */
    if (low > high)
    {
        return -1;
    }

    mid = low + (high - low) / 2;

    /* Target found */
    if (arr[mid] == target)
    {
        return mid;
    }

    /* Search in left half */
    if (target < arr[mid])
    {
        return binarySearch(arr, low, mid - 1, target);
    }

    /* Search in right half */
    return binarySearch(arr, mid + 1, high, target);
}

int main()
{
    int arr[100];
    int n, i, target, result;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements in sorted order:\n", n);

    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Enter element to search: ");
    scanf("%d", &target);

    result = binarySearch(arr, 0, n - 1, target);

    if (result != -1)
    {
        printf("\n%d is present at index %d.", target, result);
    }
    else
    {
        printf("\n%d is not present in the array.", target);
    }

    return 0;
}
