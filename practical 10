
#include <stdio.h>
#define MAX 100

char queue[MAX];
int front = -1, rear = -1;

// Transmit data
void transmit(char data) {
    if (rear == MAX - 1) {
        printf("Transmission buffer is full!\n");
        return;
    }

    if (front == -1)
        front = 0;

    queue[++rear] = data;
    printf("Transmitted: %c\n", data);
}

// Receive data
void receive() {
    if (front == -1 || front > rear) {
        printf("No data to receive!\n");
        return;
    }

    printf("Received: %c\n", queue[front]);
    front++;

    if (front > rear)
        front = rear = -1;
}

void display() {
    int i;

    if (front == -1) {
        printf("Buffer is empty.\n");
        return;
    }

    printf("Buffer data: ");
    for (i = front; i <= rear; i++)
        printf("%c ", queue[i]);

    printf("\n");
}

int main() {
    int choice;
    char data;

    do {
        printf("\n--- UART COMMUNICATION ---\n");
        printf("1. Transmit Data\n");
        printf("2. Receive Data\n");
        printf("3. Display Buffer\n");
        printf("4. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Enter character to transmit: ");
                scanf(" %c", &data);
                transmit(data);
                break;

            case 2:
                receive();
                break;

            case 3:
                display();
                break;

            case 4:
                printf("UART simulation ended.\n");
                break;

            default:
                printf("Invalid choice!\n");
        }
    } while (choice != 4);

    return 0;
}
